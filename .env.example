# AI Provider config (gemini or openai)
AI_PROVIDER=gemini

# API Credentials (get your key from Google AI Studio or OpenAI Dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o

# Server Configuration
PORT=3000
HOST=127.0.0.1
